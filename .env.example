# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (UK) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Flutterwave (Nigerian merchant, The 36th Solutions Ltd) ---
FLW_SECRET_KEY=

# --- Pricing: you control the customer FX rate ---
# NGN the customer gets per GBP 1 (set BELOW mid-market; the gap is your margin)
NGN_PER_GBP=2050
# Flat service fee in pence added to every order
SERVICE_FEE_PENCE=99
# Min/max order in NGN
MIN_ORDER_NGN=50
MAX_ORDER_NGN=500000

# --- WhatsApp Cloud API (reuse Nowrumble setup) ---
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template name (switch to nolgic_receipt once approved)
WHATSAPP_TEMPLATE=stillhome_receipt

# --- Founder alerts (Resend) ---
RESEND_API_KEY=
ALERT_EMAIL=you@example.com
ALERT_FROM=Nolgic <alerts@songsnap.online>
# Alert when NGN wallet drops below this
LOW_BALANCE_NGN=100000

# --- Receipts & cron ---
EMAIL_FROM=Nolgic <receipts@songsnap.online>
CRON_SECRET=

# --- Security (REQUIRED in production) ---------------------------------
# Crons now FAIL CLOSED: without CRON_SECRET the daily jobs return 401.
# Generate long random values, e.g.  openssl rand -hex 32
# CRON_SECRET=            (set above — Vercel sends it automatically to crons)
ADMIN_SECRET=             # x-admin-secret header for /api/admin/partners/*
ADMIN_PASSWORD=           # Bearer password for /admin dashboard + /api/admin

# --- Paystack (naira collection) ---------------------------------------
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_NGN_PAY_ENABLED=
# Fee = pct% of amount, min/max (naira)
NEXT_PUBLIC_NG_FEE_PCT=2
NEXT_PUBLIC_NG_FEE_MIN=100
NEXT_PUBLIC_NG_FEE_MAX=500

# --- Launch switches (leave unset until ready) --------------------------
NEXT_PUBLIC_UK_PAY_ENABLED=
NEXT_PUBLIC_GH_ENABLED=

# --- Bills provider (optional: VTpass instead of Flutterwave) ----------
# Default is Flutterwave. Set BILLS_PROVIDER=vtpass or =paybeta to switch (Nigeria only).
# Start with VTPASS_ENV=sandbox (fake money) — flip to live only after tests pass.
BILLS_PROVIDER=
VTPASS_ENV=sandbox
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
# 11-digit Nigerian mobile you own. VTpass requires a phone on every vend; it is used
# for electricity/TV orders where the customer didn't give a WhatsApp number.
VTPASS_DEFAULT_PHONE=

# Paybeta (BILLS_PROVIDER=paybeta). Sandbox and live have DIFFERENT keys — never put the sandbox key in Production.
# Paybeta has no requery endpoint: set the webhook in the Paybeta console to https://www.nolgic.com/api/paybeta/webhook
# and run supabase/migrations/0015_paybeta_events.sql once.
PAYBETA_ENV=sandbox
PAYBETA_API_KEY=
# Only if the Paybeta console shows a SEPARATE "secret key" (used to sign webhooks). Leave empty if it shows just one key.
PAYBETA_SECRET_KEY=
# PAYBETA_POSTPAID=1    # also list postpaid meters (the docs only show prepaid)
# PAYBETA_BASE=         # via the relay, only if Paybeta asks for a whitelisted IP: https://relay.nolgic.com/paybeta

# --- Fixed-IP relay (optional; see /relay/README.md) --------------------
# Only needed if your provider requires a whitelisted server IP. Unset = calls go direct.
RELAY_KEY=
VTPASS_BASE=            # e.g. https://relay.nolgic.com/vtpass
FLW_BASE=               # e.g. https://relay.nolgic.com/flutterwave
